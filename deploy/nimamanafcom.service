# systemd user service for nimamanafcom
#
# Installation:
#   mkdir -p ~/.config/systemd/user/
#   cp deploy/nimamanafcom.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable nimamanafcom
#   systemctl --user start nimamanafcom
#
# Logs:
#   journalctl --user -u nimamanafcom -f
#
# Status:
#   systemctl --user status nimamanafcom

[Unit]
Description=nimamanafcom - Private Personal Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/nima/code/web/personal/nimamanafcom
Environment="PATH=/home/nima/code/web/personal/nimamanafcom/venv/bin:/usr/bin"
ExecStart=/home/nima/code/web/personal/nimamanafcom/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Output
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
