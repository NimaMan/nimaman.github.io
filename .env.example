# nimamanafcom configuration
# Copy this file to .env and fill in the values

# Required: Secret key for signing session cookies
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Required: Bcrypt hash of your password
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
PASSWORD_HASH=$2b$12$your-hash-here

# Optional: Session timeout in hours (default: 24)
SESSION_TIMEOUT_HOURS=24

# Optional: Host and port (default: 127.0.0.1:8000)
# WARNING: Do NOT change HOST - app must bind to localhost only
HOST=127.0.0.1
PORT=8000

# Optional: Path to Ralph installation
RALPH_PATH=/home/nima/code/ralph
