---
// Redirect/alias for the old post URL.
//
// The lost-sales-only post was renamed and rewritten as the broadened
// "Evolution Strategies for Inventory Control" article (ten problems). The
// post slug is derived from the Markdown filename, so renaming the source file
// changed the URL from /posts/lost_sales_rl to
// /posts/evolution-strategies-for-inventory-control.
//
// This page preserves the OLD URL on any static host (GitHub Pages / Cloudflare
// Pages / Netlify / a plain web server) without depending on a host-specific
// redirect rule: with `output: "static"` it builds to
// dist/posts/lost_sales_rl/index.html, an HTML page that meta-refreshes to the
// new URL and declares the new URL as canonical for search engines.
const target = "/posts/evolution-strategies-for-inventory-control";
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://nimamanaf.com";
const canonical = `${site}${target}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <title>Moved — Evolution Strategies for Inventory Control</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      This post has moved to
      <a href={target}>Evolution Strategies for Inventory Control</a>.
    </p>
  </body>
</html>
