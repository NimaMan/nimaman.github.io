---
// /posts — a reverse-chronological archive with optional category filters.
// Steps:
// 1. Load every public post in date-descending order via getPublicPosts().
// 2. Group that sequence by UTC year, preserving its order within each year.
// 3. Render each post once, with its date, category path, series label and dek.
// 4. Give category links their shared categoryAnchor() IDs; posts-filter.js
//    reads the hash, hides unmatched posts/empty years and announces the count.
// Everything remains listed without JavaScript. Existing category links still
// land on the filter strip, and the separate Value Chains hub keeps its reading
// sequence so the archive can put the latest writing first.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import siteData from "../../data/site-data.json";
import {
  categorySegments,
  categoryAnchor,
  formatPostDate,
  getPublicPosts,
  postCategories,
  postExcerpt,
  postSlug,
  type PostEntry,
} from "../../lib/posts";

const { homePage } = siteData;
const archiveHeading = "Essays, newest first.";
const archiveIntro = "Long-form essays and research notes on value chains, money and music, optimization and learning, and mathematical curiosities.";
const posts = await getPublicPosts();
const categories = postCategories(posts);

const byYear = new Map<number, PostEntry[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  const entries = byYear.get(year);
  if (entries) entries.push(post);
  else byYear.set(year, [post]);
}
const years = Array.from(byYear, ([year, entries]) => ({ year, posts: entries }));
---

<BaseLayout title={`Articles on value chains, music, learning & mathematics | ${homePage.short_name}`} description={archiveIntro} bodyClass="public-page">
  <SiteNav activePage="posts" />

  <main class="listing-page" data-post-listing>
    <section class="page-hero">
      <div class="site-shell">
        <p class="eyebrow">Articles</p>
        <h1>{archiveHeading}</h1>
        <p class="page-intro">{archiveIntro}</p>
        <nav class="category-jumps category-jumps--filters" aria-label="Filter articles by category">
          <a href="#all" id="all" data-post-filter="" data-category-name="All" aria-current="true">
            All<span class="category-jumps__count">{posts.length}<span class="visually-hidden"> articles</span></span>
          </a>
          {categories.map((category) => (
            <a href={`#${category.id}`} id={category.id} data-post-filter={category.id} data-category-name={category.name}>
              {category.name}<span class="category-jumps__count">{category.count}<span class="visually-hidden"> {category.count === 1 ? "article" : "articles"}</span></span>
            </a>
          ))}
        </nav>
        <div class="archive-summary">
          <p class="archive-summary__count" role="status" aria-live="polite" aria-atomic="true" data-post-count>
            {posts.length} {posts.length === 1 ? "article" : "articles"} · Newest first
          </p>
          <a href="/value_chains" class="text-link">Read Value Chains in sequence</a>
        </div>
      </div>
    </section>

    <div class="site-shell article-archive">
      {years.map(({ year, posts: entries }) => (
        <section class="archive-year" aria-labelledby={`year-${year}`} data-post-year>
          <h2 class="section-title archive-year__title" id={`year-${year}`}>{year}</h2>
          <div class="article-grid archive-posts">
            {entries.map((post) => {
              const path = categorySegments(post);
              const category = path[0] ?? "Uncategorized";
              const excerpt = postExcerpt(post);
              const href = `/posts/${postSlug(post)}`;
              return (
                <article class="article-card archive-card" data-post-category={categoryAnchor(category)}>
                  <time class="article-card__date" datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
                  <div class="archive-card__content">
                    <p class="archive-card__meta">
                      <span>{path.length ? path.join(" · ") : category}</span>
                      {post.data.series_label && <span class="archive-card__series">{post.data.series_label}</span>}
                    </p>
                    <h3><a href={href}>{post.data.title}</a></h3>
                    {excerpt && <p>{excerpt}</p>}
                    <a href={href} class="text-link" aria-label={`Read article: ${post.data.title}`}>Read article</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>

  <SiteFooter />
  <script slot="scripts" is:inline defer src="/static/js/posts-filter.js"></script>
</BaseLayout>
