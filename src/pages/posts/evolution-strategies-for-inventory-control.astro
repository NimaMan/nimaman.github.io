---
// Redirect/alias for the former inventory article URL.
//
// The article was renamed from
// /posts/evolution-strategies-for-inventory-control to
// /posts/learning-to-control-inventory-management-systems. This static page
// keeps old links working on GitHub Pages without host-specific redirects.
const target = "/posts/learning-to-control-inventory-management-systems";
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://nimamanaf.com";
const canonical = `${site}${target}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <title>Moved — Learning to Control Inventory Management Systems</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      This post has moved to
      <a href={target}>Learning to Control Inventory Management Systems</a>.
    </p>
  </body>
</html>
