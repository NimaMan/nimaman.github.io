---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import siteData from "../../data/site-data.json";
import { formatPostDate, getPublicPosts, getSeriesPosts, postExcerpt, postSlug, type PostEntry } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: PostEntry;
}

const { homePage } = siteData;
const { post } = Astro.props;
const { Content } = await render(post);
const slug = postSlug(post);
const isPiPost = slug === "pi";
const isInventoryPost = slug === "learning-to-control-inventory-management-systems";
const PiVisual = isPiPost ? (await import("../../components/PiVisual.astro")).default : undefined;
const InventoryNetworkDiagram = isInventoryPost ? (await import("../../components/InventoryNetworkDiagram.astro")).default : undefined;
const description = post.data.description || postExcerpt(post);
const seriesSiblings = post.data.series ? await getSeriesPosts(post.data.series) : [];
---

<BaseLayout title={`${post.data.title} | ${homePage.short_name}`} description={description} bodyClass={`public-page article-page${isPiPost ? " pi-article-page" : ""}${isInventoryPost ? " inventory-article-page" : ""}`}>
  {
    post.data.math && (
      <Fragment slot="head">
        <script is:inline>
          window.MathJax = {
            tex: {
              inlineMath: [["$", "$"], ["\\(", "\\)"]],
              displayMath: [["$$", "$$"], ["\\[", "\\]"]]
            },
            svg: {
              fontCache: "global"
            }
          };
        </script>
        <script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
      </Fragment>
    )
  }

  <SiteNav activePage="posts" />

  <main class="article-layout">
    <div class:list={["site-shell", "article-layout__inner", { "article-layout__inner--pi": isPiPost, "article-layout__inner--inventory": isInventoryPost }]}>
      <a href="/posts" class="text-link article-back">Back to all articles</a>
      <header class="article-header">
        {post.data.series === "value_chains" ? (
          <p class="eyebrow"><a href="/value_chains">Value Chains{post.data.series_label ? ` · ${post.data.series_label}` : ""}</a></p>
        ) : (
          <p class="eyebrow">Article</p>
        )}
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <span>{formatPostDate(post.data.date)}</span>
          <span>{post.data.author || homePage.name}</span>
        </div>
        {postExcerpt(post) && <p class="article-dek">{postExcerpt(post)}</p>}
      </header>

      <article class:list={["article-prose", { "article-prose--pi": isPiPost, "article-prose--inventory": isInventoryPost }]}>
        {isPiPost && <PiVisual />}{isInventoryPost && <InventoryNetworkDiagram />}<Content />
      </article>

      {post.data.series && <SeriesNav current={post} siblings={seriesSiblings} />}
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
