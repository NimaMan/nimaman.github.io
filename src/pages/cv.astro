---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import siteData from "../data/site-data.json";

const {
  homePage,
  cvProfile,
  cvExperience,
  cvEducation,
  cvLeadership,
  cvSkills,
  cvHighlights,
  cvLanguages,
  cvInterests,
  socialLinks,
} = siteData;
const cvLinks = socialLinks.filter((link) => ["Email", "LinkedIn", "GitHub", "Scholar"].includes(link.label));
---

<BaseLayout title={`CV | ${homePage.short_name}`} description={`Curriculum vitae of ${homePage.name}.`} bodyClass="public-page">
  <SiteNav activePage="cv" />

  <main class="cv-page">
    <section class="page-hero">
      <div class="site-shell cv-hero">
        <div>
          <p class="eyebrow">Curriculum Vitae</p>
          <h1>{cvProfile.name}</h1>
          <p class="cv-role">{cvProfile.title}</p>
          <p class="page-intro">{cvProfile.summary}</p>
        </div>
        <div class="cv-summary-card">
          <p>{cvProfile.location}</p>
          <div class="tag-row">
            <span>Finance</span>
            <span>Optimization</span>
            <span>Machine learning</span>
          </div>
          <div class="cv-link-row" aria-label="CV contact and profile links">
            {
              cvLinks.map((link) => (
                <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="site-shell cv-section">
        <div class="section-heading">
          <p class="eyebrow">Experience</p>
          <h2 class="section-title">Industry and research roles.</h2>
        </div>
        <div class="timeline">
          {
            cvExperience.map((item) => (
              <article class="timeline-item">
                <p class="timeline-date">{item.date_range}</p>
                <h3>{item.title}</h3>
                <p class="timeline-org">{item.organization} | {item.location}</p>
                <ul class="detail-list">
                  {item.points.map((point) => <li>{point}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block section-light">
      <div class="site-shell cv-section">
        <div class="section-heading">
          <p class="eyebrow">Education</p>
          <h2 class="section-title">Formal training and research foundations.</h2>
        </div>
        <div class="stack-grid">
          {
            cvEducation.map((item) => (
              <article class="stack-card">
                <p class="stack-card__meta">{item.date_range}</p>
                <h3>{item.degree}</h3>
                <p class="stack-card__title">{item.institution} | {item.location}</p>
                <ul class="detail-list">
                  {item.details.map((point) => <li>{point}</li>)}
                </ul>
                {
                  item.links && (
                    <div class="cv-link-row">
                      {item.links.map((link) => (
                        <a href={link.href} target="_blank" rel="noreferrer">
                          {link.label}
                        </a>
                      ))}
                    </div>
                  )
                }
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="site-shell cv-section">
        <div class="section-heading">
          <p class="eyebrow">Supervision</p>
          <h2 class="section-title">Students, mentoring, and project leadership.</h2>
        </div>
        <div class="stack-grid stack-grid--compact">
          {
            cvLeadership.map((item) => (
              <article class="stack-card">
                <h3>{item.title}</h3>
                <ul class="detail-list">
                  {item.items.map((point) => <li>{point}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block section-light">
      <div class="site-shell cv-section">
        <div class="section-heading">
          <p class="eyebrow">Skills</p>
          <h2 class="section-title">Methods, tools, and domains.</h2>
        </div>
        <div class="card-grid">
          {
            cvSkills.map((item) => (
              <article class="info-card">
                <h3>{item.title}</h3>
                <ul class="detail-list">
                  {item.items.map((skill) => <li>{skill}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="site-shell cv-section">
        <div class="section-heading">
          <p class="eyebrow">Highlights</p>
          <h2 class="section-title">Awards, patents, grants, and scholarships.</h2>
        </div>
        <div class="stack-grid stack-grid--compact">
          {
            cvHighlights.map((item) => (
              <article class="stack-card">
                <h3>{item.title}</h3>
                <ul class="detail-list">
                  {item.items.map((point) => <li>{point}</li>)}
                </ul>
                {
                  item.links && (
                    <div class="cv-link-row">
                      {item.links.map((link) => (
                        <a href={link.href} target="_blank" rel="noreferrer">
                          {link.label}
                        </a>
                      ))}
                    </div>
                  )
                }
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block section-light">
      <div class="site-shell cv-section">
        <div class="section-heading">
          <p class="eyebrow">Languages and Interests</p>
          <h2 class="section-title">The human context around the work.</h2>
        </div>
        <div class="cv-context-grid">
          <article class="stack-card">
            <h3>Languages</h3>
            <div class="cv-language-list">
              {
                cvLanguages.map((item) => (
                  <p>
                    <span>{item.language}</span>
                    <strong>{item.level}</strong>
                  </p>
                ))
              }
            </div>
          </article>
          <article class="stack-card">
            <h3>Interests</h3>
            <div class="tag-row">
              {cvInterests.map((item) => <span>{item}</span>)}
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
