---
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "Nima Manaf",
  description = "Machine learning, optimization, and risk analytics by Nima Manafzadeh Dizbin.",
  bodyClass = "",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <slot name="scripts" />
  </body>
</html>
