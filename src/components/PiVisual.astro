---
const piDigits =
  "314159265358979323846264338327950288419716939937510582097494459230781640628620899862803482534211706798214808651328230664709384460955058223172535940812848111745028410270193852110555964462294895493038196";

const tones = ["#f2b35f", "#2bc7bd", "#ff6b4a", "#b7df62", "#f38ab0"];

const beatBars = Array.from({ length: 72 }, (_, index) => {
  const digit = Number(piDigits[index % piDigits.length]);
  const next = Number(piDigits[(index + 5) % piDigits.length]);
  const height = 18 + ((digit * 9 + next * 7 + index) % 78);
  const delay = -((index % 24) * 0.09 + digit * 0.035);
  const duration = 1.8 + ((digit + next) % 7) * 0.18;
  const tone = tones[(digit + index) % tones.length];

  return {
    style: `--h:${height}%; --delay:${delay.toFixed(2)}s; --dur:${duration.toFixed(2)}s; --tone:${tone};`,
  };
});

const digitTape = Array.from({ length: 180 }, (_, index) => {
  const digit = piDigits[index % piDigits.length];
  const delay = -((index % 45) * 0.06 + Number(digit) * 0.025);
  const tone = tones[(Number(digit) + index) % tones.length];

  return {
    digit,
    style: `--delay:${delay.toFixed(2)}s; --tone:${tone};`,
  };
});

const orbitMarks = Array.from({ length: 36 }, (_, index) => {
  const digit = piDigits[index % piDigits.length];
  const tone = tones[(Number(digit) + index) % tones.length];
  const turn = (index / 36) * 360 + Number(digit) * 1.7;

  return {
    digit,
    style: `--turn:${turn.toFixed(2)}deg; --tone:${tone};`,
  };
});
---

<section class="pi-rhythm" data-pi-rhythm data-pi-digits={piDigits} aria-label="Pi rhythm visualization">
  <div class="pi-rhythm__stage">
    <canvas class="pi-rhythm__canvas" data-pi-webgl aria-label="Three dimensional rhythm generated from the digits of pi"></canvas>

    <div class="pi-rhythm__signal" aria-hidden="true">
      <span>3.14159265358979323846</span>
      <strong><em>π</em></strong>
    </div>

    <div class="pi-rhythm__orbit" aria-hidden="true">
      {orbitMarks.map((mark) => <span style={mark.style}>{mark.digit}</span>)}
    </div>

    <div class="pi-rhythm__meter" aria-hidden="true">
      {beatBars.map((bar) => <span style={bar.style}></span>)}
    </div>

    <div class="pi-rhythm__tape" aria-hidden="true">
      {digitTape.map((item) => <span style={item.style}>{item.digit}</span>)}
    </div>
  </div>

  <div class="pi-rhythm__caption">
    <span>Orbit</span>
    <span>Pulse</span>
    <span>Drift</span>
  </div>
</section>

<script>
  import * as THREE from "three";

  const roots = document.querySelectorAll("[data-pi-rhythm]");
  const reduceQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  roots.forEach((root) => {
    const canvas = root.querySelector("[data-pi-webgl]");
    const stage = root.querySelector(".pi-rhythm__stage");

    if (!(canvas instanceof HTMLCanvasElement) || !(stage instanceof HTMLElement)) return;

    const digits = (root.getAttribute("data-pi-digits") || "")
      .split("")
      .map((digit) => Number(digit))
      .filter((digit) => Number.isFinite(digit));

    const digitAt = (index) => digits[((index % digits.length) + digits.length) % digits.length] || 0;
    const colors = [0xf2b35f, 0x2bc7bd, 0xff6b4a, 0xb7df62, 0xf38ab0].map((color) => new THREE.Color(color));

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      preserveDrawingBuffer: true,
      powerPreference: "high-performance",
    });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 80);
    camera.position.set(0, 0, 9.2);

    const rootGroup = new THREE.Group();
    rootGroup.rotation.x = -0.18;
    scene.add(rootGroup);

    scene.add(new THREE.AmbientLight(0xd7fff3, 1.2));

    const keyLight = new THREE.PointLight(0xf2b35f, 36, 18);
    keyLight.position.set(3.5, -2.2, 6);
    scene.add(keyLight);

    const coolLight = new THREE.PointLight(0x2bc7bd, 22, 18);
    coolLight.position.set(-4, 2.5, 5);
    scene.add(coolLight);

    const coreMaterial = new THREE.MeshStandardMaterial({
      color: 0x0b1518,
      emissive: 0x2bc7bd,
      emissiveIntensity: 0.8,
      metalness: 0.26,
      roughness: 0.34,
      transparent: true,
      opacity: 0.96,
    });
    const core = new THREE.Mesh(new THREE.IcosahedronGeometry(0.78, 3), coreMaterial);
    rootGroup.add(core);

    const rings = Array.from({ length: 5 }, (_, index) => {
      const digit = digitAt(index);
      const radius = 1.25 + index * 0.5 + digit * 0.012;
      const tube = 0.014 + index * 0.004;
      const material = new THREE.MeshStandardMaterial({
        color: colors[index % colors.length],
        emissive: colors[index % colors.length],
        emissiveIntensity: 1.2 - index * 0.12,
        metalness: 0.08,
        roughness: 0.42,
        transparent: true,
        opacity: 0.62 - index * 0.045,
      });
      const mesh = new THREE.Mesh(new THREE.TorusGeometry(radius, tube, 10, 180), material);
      mesh.rotation.x = Math.PI / 2 + index * 0.22;
      mesh.rotation.y = index * 0.36;
      mesh.userData = {
        speed: 0.16 + digit * 0.018 + index * 0.025,
        pulse: 0.022 + digit * 0.004,
      };
      rootGroup.add(mesh);
      return mesh;
    });

    const rodGroup = new THREE.Group();
    rootGroup.add(rodGroup);
    const rods = Array.from({ length: 72 }, (_, index) => {
      const digit = digitAt(index);
      const next = digitAt(index + 1);
      const material = new THREE.MeshStandardMaterial({
        color: colors[(digit + index) % colors.length],
        emissive: colors[(next + index) % colors.length],
        emissiveIntensity: 0.9,
        transparent: true,
        opacity: 0.76,
        roughness: 0.38,
      });
      const mesh = new THREE.Mesh(new THREE.BoxGeometry(0.026, 0.34 + digit * 0.035, 0.026), material);
      const angle = (index / 72) * Math.PI * 2;
      const radius = 3.15 + ((digit + next) % 5) * 0.035;
      mesh.position.set(Math.cos(angle) * radius, Math.sin(angle) * radius, -0.1);
      mesh.rotation.z = angle;
      mesh.userData = {
        phase: index * 0.19 + digit,
      };
      rodGroup.add(mesh);
      return mesh;
    });

    const pointCount = 420;
    const positions = new Float32Array(pointCount * 3);
    const pointColors = new Float32Array(pointCount * 3);
    const baseAngles = new Float32Array(pointCount);
    const baseRadii = new Float32Array(pointCount);
    const baseDepths = new Float32Array(pointCount);

    for (let i = 0; i < pointCount; i += 1) {
      const digit = digitAt(i);
      const next = digitAt(i + 1);
      const color = colors[(digit + i) % colors.length];
      baseAngles[i] = i * 2.399963 + digit * 0.087 + next * 0.021;
      baseRadii[i] = 0.8 + (((digit * 13 + next * 7 + i) % 100) / 100) * 3.15;
      baseDepths[i] = ((next - 4.5) / 4.5) * 0.95;
      pointColors[i * 3] = color.r;
      pointColors[i * 3 + 1] = color.g;
      pointColors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    particleGeometry.setAttribute("color", new THREE.BufferAttribute(pointColors, 3));

    const particleMaterial = new THREE.PointsMaterial({
      size: 0.055,
      sizeAttenuation: true,
      vertexColors: true,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const particles = new THREE.Points(particleGeometry, particleMaterial);
    rootGroup.add(particles);

    let frame = 0;

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      const width = Math.max(1, rect.width);
      const height = Math.max(1, rect.height);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };

    const render = (timestamp, continueAnimation) => {
      const t = timestamp * 0.001;
      const beatIndex = Math.floor(t * 10) % digits.length;
      const beat = digitAt(beatIndex) / 9;
      const slowBeat = digitAt(beatIndex + 13) / 9;

      rootGroup.rotation.z = Math.sin(t * 0.19) * 0.08;
      rootGroup.rotation.y = Math.sin(t * 0.27) * 0.16;

      core.rotation.x = t * 0.31;
      core.rotation.y = t * 0.47;
      core.scale.setScalar(1 + beat * 0.16 + Math.sin(t * 2.4) * 0.035);
      coreMaterial.emissiveIntensity = 0.76 + beat * 0.7;

      rings.forEach((ring, index) => {
        const ringBeat = digitAt(beatIndex + index * 7) / 9;
        const direction = index % 2 === 0 ? 1 : -1;
        ring.rotation.z += direction * ring.userData.speed * 0.012;
        ring.rotation.x += direction * 0.0025;
        ring.scale.setScalar(1 + Math.sin(t * (1.2 + index * 0.18) + ringBeat * Math.PI) * ring.userData.pulse + ringBeat * 0.035);
        ring.material.opacity = 0.34 + ringBeat * 0.42;
      });

      rods.forEach((rod, index) => {
        const digit = digitAt(beatIndex + index);
        const lift = 0.55 + (digit / 9) * 1.65 + Math.max(0, Math.sin(t * 3.2 + rod.userData.phase)) * 0.58;
        rod.scale.y = lift;
        rod.position.z = -0.45 + lift * 0.08 + slowBeat * 0.15;
        rod.material.opacity = 0.38 + (digit / 9) * 0.52;
      });

      for (let i = 0; i < pointCount; i += 1) {
        const digit = digitAt(i + beatIndex);
        const next = digitAt(i + beatIndex + 1);
        const angle = baseAngles[i] + t * (0.06 + digit * 0.004) + Math.sin(t * 0.34 + i * 0.011) * 0.18;
        const radius = baseRadii[i] * (0.88 + beat * 0.08) + Math.sin(t * 1.7 + next) * 0.08;
        positions[i * 3] = Math.cos(angle) * radius;
        positions[i * 3 + 1] = Math.sin(angle * (1.02 + next * 0.002)) * radius * 0.72;
        positions[i * 3 + 2] = baseDepths[i] + Math.sin(t * 0.9 + digit + i * 0.03) * 0.42;
      }
      particleGeometry.attributes.position.needsUpdate = true;

      renderer.render(scene, camera);

      if (continueAnimation && !reduceQuery.matches) {
        frame = window.requestAnimationFrame((time) => render(time, true));
      }
    };

    const start = () => {
      window.cancelAnimationFrame(frame);
      resize();
      render(window.performance.now(), false);
      if (!reduceQuery.matches) {
        frame = window.requestAnimationFrame((time) => render(time, true));
      }
    };

    const stop = () => {
      window.cancelAnimationFrame(frame);
      frame = 0;
      render(3141.59, false);
    };

    const observer = new ResizeObserver(start);
    observer.observe(stage);

    reduceQuery.addEventListener("change", () => {
      if (reduceQuery.matches) {
        stop();
      } else {
        start();
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        window.cancelAnimationFrame(frame);
      } else {
        start();
      }
    });

    start();
  });
</script>

<style is:inline>
  .pi-article-page .article-layout__inner--pi {
    width: min(1180px, calc(100% - 2.5rem));
  }

  .pi-article-page .article-header {
    max-width: 760px;
    padding-bottom: 1.35rem;
    margin-bottom: 1.35rem;
  }

  .pi-article-page .article-prose--pi {
    max-width: none;
  }

  .pi-article-page .article-prose--pi > p {
    max-width: 58ch;
  }

  .pi-rhythm {
    margin: 0 0 2.4rem;
  }

  .pi-rhythm__stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 650px;
    aspect-ratio: 16 / 9.7;
    overflow: hidden;
    border: 1px solid rgba(12, 22, 26, 0.64);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 50% 46%, rgba(43, 199, 189, 0.2), transparent 24%),
      radial-gradient(circle at 35% 68%, rgba(242, 179, 95, 0.18), transparent 29%),
      radial-gradient(circle at 70% 32%, rgba(255, 107, 74, 0.16), transparent 26%),
      linear-gradient(135deg, #061014 0%, #0d1717 48%, #15170d 100%);
    box-shadow: 0 28px 70px rgba(8, 16, 18, 0.28);
  }

  .pi-rhythm__stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.5;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(247, 238, 224, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 238, 224, 0.045) 1px, transparent 1px),
      repeating-radial-gradient(circle at center, transparent 0 72px, rgba(247, 238, 224, 0.055) 73px 74px);
    background-size: 32px 32px, 32px 32px, 100% 100%;
  }

  .pi-rhythm__canvas {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
  }

  .pi-rhythm__signal {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    top: clamp(1rem, 3vw, 2rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: #dbe9df;
    pointer-events: none;
  }

  .pi-rhythm__signal span {
    color: #8bd6c9;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .pi-rhythm__signal strong {
    display: grid;
    place-items: center;
    width: 2.6rem;
    aspect-ratio: 1;
    color: #f7eee0;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1;
    border: 1px solid rgba(242, 179, 95, 0.38);
    background: rgba(6, 16, 20, 0.54);
    transform: rotate(45deg);
    box-shadow: 0 0 24px rgba(242, 179, 95, 0.18);
  }

  .pi-rhythm__signal strong em {
    display: block;
    font-style: normal;
    transform: rotate(-45deg);
  }

  .pi-rhythm__orbit {
    position: absolute;
    inset: 8.5% 12% 14%;
    z-index: 3;
    pointer-events: none;
    opacity: 0.86;
    animation: pi-orbit-turn 48s linear infinite;
  }

  .pi-rhythm__orbit span {
    position: absolute;
    left: 50%;
    top: 50%;
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    text-shadow: 0 0 18px color-mix(in srgb, var(--tone) 80%, transparent);
    transform:
      rotate(var(--turn))
      translateY(calc(min(29vw, 17.5rem) * -1))
      rotate(calc(var(--turn) * -1));
    animation: pi-digit-pop 2.2s ease-in-out infinite;
  }

  .pi-rhythm__meter {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    bottom: 5.6rem;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(72, minmax(2px, 1fr));
    align-items: end;
    gap: clamp(2px, 0.35vw, 6px);
    height: 7.6rem;
    pointer-events: none;
  }

  .pi-rhythm__meter span {
    display: block;
    height: var(--h);
    min-height: 10%;
    background: linear-gradient(180deg, #f7eee0, var(--tone));
    transform-origin: bottom;
    opacity: 0.66;
    box-shadow: 0 0 18px color-mix(in srgb, var(--tone) 58%, transparent);
    animation: pi-meter-beat var(--dur) cubic-bezier(0.45, 0, 0.2, 1) infinite;
    animation-delay: var(--delay);
  }

  .pi-rhythm__tape {
    position: absolute;
    inset: auto 0 0;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(60, minmax(0, 1fr));
    align-items: center;
    height: 4.4rem;
    overflow: hidden;
    padding: 0 1rem;
    border-top: 1px solid rgba(247, 238, 224, 0.16);
    background: rgba(5, 13, 15, 0.78);
    backdrop-filter: blur(9px);
  }

  .pi-rhythm__tape span {
    min-width: 0;
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    text-align: center;
    opacity: 0.58;
    text-shadow: 0 0 12px color-mix(in srgb, var(--tone) 45%, transparent);
    animation: pi-tape-pulse 3.1s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .pi-rhythm__caption {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(12, 22, 26, 0.18);
    border-top: 0;
    background: #f6efe4;
    color: #263439;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pi-rhythm__caption span {
    min-width: 0;
    padding: 0.78rem 1rem;
    border-right: 1px solid rgba(12, 22, 26, 0.16);
  }

  .pi-rhythm__caption span:last-child {
    border-right: 0;
  }

  @keyframes pi-orbit-turn {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes pi-digit-pop {
    0%,
    100% {
      opacity: 0.36;
      scale: 0.74;
    }
    48% {
      opacity: 1;
      scale: 1.22;
    }
  }

  @keyframes pi-meter-beat {
    0%,
    100% {
      opacity: 0.34;
      transform: scaleY(0.32);
    }
    42% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @keyframes pi-tape-pulse {
    0%,
    100% {
      opacity: 0.4;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-0.55rem);
    }
  }

  @media (max-width: 760px) {
    .pi-article-page .article-layout__inner--pi {
      width: min(calc(100% - 1rem), 1180px);
      padding-inline: 1rem;
    }

    .pi-rhythm__stage {
      min-height: 610px;
      aspect-ratio: 4 / 5.6;
    }

    .pi-rhythm__orbit {
      inset: 10% 10% 19%;
    }

    .pi-rhythm__orbit span {
      transform:
        rotate(var(--turn))
        translateY(calc(min(38vw, 12rem) * -1))
        rotate(calc(var(--turn) * -1));
    }

    .pi-rhythm__meter {
      bottom: 5rem;
      grid-template-columns: repeat(36, minmax(2px, 1fr));
      height: 6.5rem;
    }

    .pi-rhythm__tape {
      grid-template-columns: repeat(30, minmax(0, 1fr));
      height: 4rem;
      padding-inline: 0.6rem;
    }

    .pi-rhythm__caption {
      grid-template-columns: 1fr;
    }

    .pi-rhythm__caption span {
      border-right: 0;
      border-bottom: 1px solid rgba(12, 22, 26, 0.16);
    }

    .pi-rhythm__caption span:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-rhythm__orbit,
    .pi-rhythm__orbit span,
    .pi-rhythm__meter span,
    .pi-rhythm__tape span {
      animation: none;
    }
  }
</style>
