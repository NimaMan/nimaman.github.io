---
const piDigits =
  "314159265358979323846264338327950288419716939937510582097494459230781640628620899862803482534211706798214808651328230664709384460955058223172535940812848111745028410270193852110555964462294895493038196";

const tones = ["#f2b35f", "#2bc7bd", "#ff6b4a", "#b7df62", "#f38ab0"];

const particles = Array.from({ length: 108 }, (_, index) => {
  const digit = Number(piDigits[index % piDigits.length]);
  const next = Number(piDigits[(index + 1) % piDigits.length]);
  const angle = (((index * 137.508 + digit * 11.25 + next * 3.5) % 360) * Math.PI) / 180;
  const radius = 16 + ((digit * 3 + next * 5 + index) % 37);
  const x = 50 + Math.cos(angle) * radius;
  const y = 48 + Math.sin(angle) * radius * 0.78;
  const size = 3 + ((digit + index) % 7);
  const delay = -((index % 32) * 0.19 + digit * 0.03);
  const duration = 4.8 + ((digit + next) % 6) * 0.45;
  const tone = tones[(digit + index) % tones.length];

  return {
    digit,
    style: `--x:${x.toFixed(2)}%; --y:${y.toFixed(2)}%; --size:${size}px; --delay:${delay.toFixed(2)}s; --dur:${duration.toFixed(2)}s; --tone:${tone};`,
  };
});

const digitRibbon = Array.from({ length: 156 }, (_, index) => {
  const digit = piDigits[index % piDigits.length];
  const next = Number(piDigits[(index + 1) % piDigits.length]);
  const delay = -((index % 39) * 0.08 + next * 0.02);
  const tone = tones[(Number(digit) + index) % tones.length];

  return {
    digit,
    style: `--delay:${delay.toFixed(2)}s; --tone:${tone};`,
  };
});

const pulseBars = Array.from({ length: 52 }, (_, index) => {
  const digit = Number(piDigits[index % piDigits.length]);
  const next = Number(piDigits[(index + 7) % piDigits.length]);
  const height = 18 + ((digit * 8 + next * 3 + index) % 74);
  const delay = -((index % 19) * 0.14 + digit * 0.04);
  const duration = 3.4 + ((digit + next) % 5) * 0.36;
  const tone = tones[(digit + next + index) % tones.length];

  return {
    style: `--h:${height}%; --delay:${delay.toFixed(2)}s; --dur:${duration.toFixed(2)}s; --tone:${tone};`,
  };
});

const rings = [
  { label: "3", style: "--size:84%; --speed:38s; --turn:0deg; --tone:#f2b35f; --alpha:0.92;" },
  { label: "1", style: "--size:67%; --speed:31s; --turn:47deg; --tone:#2bc7bd; --alpha:0.78;" },
  { label: "4", style: "--size:51%; --speed:24s; --turn:113deg; --tone:#ff6b4a; --alpha:0.72;" },
  { label: "1", style: "--size:36%; --speed:19s; --turn:211deg; --tone:#b7df62; --alpha:0.66;" },
];
---

<section class="pi-field" data-pi-root data-pi-digits={piDigits} aria-labelledby="pi-field-title">
  <div class="pi-field__intro">
    <p class="pi-field__kicker">Generated by π · orbit / residue / pulse</p>
    <h2 id="pi-field-title">A rhythm that almost repeats</h2>
  </div>

  <div class="pi-stage">
    <canvas class="pi-stage__canvas" data-pi-canvas aria-label="Animated traces generated from the digits of pi"></canvas>
    <div class="pi-stage__mesh" aria-hidden="true"></div>

    <div class="pi-rings" aria-hidden="true">
      {
        rings.map((ring) => (
          <span class="pi-ring" style={ring.style}>
            <span>{ring.label}</span>
          </span>
        ))
      }
    </div>

    <div class="pi-particles" aria-hidden="true">
      {
        particles.map((particle) => (
          <span class="pi-particle" style={particle.style}>
            <span>{particle.digit}</span>
          </span>
        ))
      }
    </div>

    <div class="pi-core" aria-hidden="true">
      <span>π</span>
      <small>3.14159</small>
    </div>

    <div class="pi-wave" aria-hidden="true">
      {pulseBars.map((bar) => <span style={bar.style}></span>)}
    </div>

    <div class="pi-digit-stream" aria-hidden="true">
      {digitRibbon.map((item) => <span style={item.style}>{item.digit}</span>)}
    </div>
  </div>

  <div class="pi-ledger" aria-label="Pi visual layers">
    <span><strong>Orbit</strong> irrational trace</span>
    <span><strong>Residue</strong> digit scatter</span>
    <span><strong>Pulse</strong> repeating cadence</span>
  </div>
</section>

<script>
  const roots = document.querySelectorAll("[data-pi-root]");
  const reduceQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  roots.forEach((root) => {
    const canvas = root.querySelector("[data-pi-canvas]");
    const stage = root.querySelector(".pi-stage");
    const ctx = canvas && canvas.getContext ? canvas.getContext("2d", { alpha: true }) : null;

    if (!canvas || !stage || !ctx) return;

    const digits = (root.getAttribute("data-pi-digits") || "")
      .split("")
      .map((digit) => Number(digit))
      .filter((digit) => Number.isFinite(digit));
    const traceColors = [
      ["rgba(43, 199, 189, 0.78)", "rgba(43, 199, 189, 0.18)"],
      ["rgba(242, 179, 95, 0.82)", "rgba(242, 179, 95, 0.16)"],
      ["rgba(255, 107, 74, 0.72)", "rgba(255, 107, 74, 0.14)"],
    ];

    let width = 1;
    let height = 1;
    let frame = 0;

    const digitAt = (index) => {
      const length = digits.length || 1;
      return digits[((index % length) + length) % length] || 0;
    };

    const drawTrace = (time, pass, cx, cy, scale) => {
      const count = 720;
      const minSide = Math.min(width, height);
      const drift = Math.floor(time * 0.012) + pass * 37;
      const gradient = ctx.createLinearGradient(cx - scale * 1.8, cy - scale, cx + scale * 1.6, cy + scale);
      gradient.addColorStop(0, traceColors[pass][1]);
      gradient.addColorStop(0.45, traceColors[pass][0]);
      gradient.addColorStop(1, traceColors[(pass + 1) % traceColors.length][0]);

      ctx.beginPath();
      for (let i = 0; i < count; i += 1) {
        const digit = digitAt(i + drift);
        const next = digitAt(i + drift + 1);
        const theta = (i / count) * Math.PI * (7.2 + pass * 1.35) + time * 0.00024 * (1 + pass * 0.2);
        const slip = theta * Math.PI * (0.46 + next / 40) + pass * Math.PI * 0.66;
        const pulse = 0.82 + 0.08 * Math.sin(i * 0.047 + time * 0.001 + digit);
        const x = cx + scale * pulse * (Math.cos(theta + digit * 0.006) + 0.64 * Math.cos(slip));
        const y = cy + scale * pulse * (Math.sin(theta + next * 0.008) + 0.64 * Math.sin(slip));

        if (i === 0) {
          ctx.moveTo(x, y);
        } else {
          ctx.lineTo(x, y);
        }
      }

      ctx.lineWidth = Math.max(1.15, minSide * (0.0027 + pass * 0.0008));
      ctx.strokeStyle = gradient;
      ctx.shadowColor = traceColors[pass][0];
      ctx.shadowBlur = Math.max(10, minSide * 0.018);
      ctx.stroke();
      ctx.shadowBlur = 0;
    };

    const drawResidueTicks = (time, cx, cy, scale) => {
      const tickCount = 90;
      const minSide = Math.min(width, height);
      ctx.lineWidth = Math.max(1, minSide * 0.0018);

      for (let i = 0; i < tickCount; i += 1) {
        const digit = digitAt(i + Math.floor(time * 0.006));
        const next = digitAt(i + 9);
        const angle = (i / tickCount) * Math.PI * 2 + digit * 0.031 + time * 0.00009;
        const radius = scale * (1.34 + ((digit + next) % 7) * 0.035);
        const x = cx + Math.cos(angle) * radius;
        const y = cy + Math.sin(angle) * radius * 0.82;
        const length = minSide * (0.012 + digit * 0.0018);

        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle + Math.PI / 2);
        ctx.strokeStyle = i % 3 === 0 ? "rgba(183, 223, 98, 0.62)" : "rgba(247, 238, 224, 0.3)";
        ctx.beginPath();
        ctx.moveTo(-length * 0.5, 0);
        ctx.lineTo(length * 0.5, 0);
        ctx.stroke();
        ctx.restore();
      }
    };

    const render = (time, shouldContinue) => {
      const cx = width * 0.5;
      const cy = height * 0.48;
      const scale = Math.min(width, height) * 0.245;

      ctx.clearRect(0, 0, width, height);
      ctx.save();
      ctx.globalCompositeOperation = "lighter";
      drawTrace(time, 0, cx, cy, scale);
      drawTrace(time + 1800, 1, cx, cy, scale * 0.94);
      drawTrace(time + 3600, 2, cx, cy, scale * 1.05);
      drawResidueTicks(time, cx, cy, scale);
      ctx.restore();

      if (shouldContinue && !reduceQuery.matches) {
        frame = window.requestAnimationFrame((nextTime) => render(nextTime, true));
      }
    };

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      render(window.performance.now(), false);
    };

    const start = () => {
      window.cancelAnimationFrame(frame);
      resize();
      if (!reduceQuery.matches) {
        frame = window.requestAnimationFrame((time) => render(time, true));
      }
    };

    const stop = () => {
      window.cancelAnimationFrame(frame);
      frame = 0;
      render(window.performance.now(), false);
    };

    const onMotionChange = () => {
      if (reduceQuery.matches) {
        stop();
      } else {
        start();
      }
    };

    const onVisibilityChange = () => {
      if (document.hidden) {
        window.cancelAnimationFrame(frame);
      } else {
        start();
      }
    };

    const observer = new ResizeObserver(resize);
    observer.observe(stage);
    reduceQuery.addEventListener("change", onMotionChange);
    document.addEventListener("visibilitychange", onVisibilityChange);
    start();
  });
</script>

<style is:inline>
  .pi-article-page .article-layout__inner--pi {
    width: min(1120px, calc(100% - 2.5rem));
  }

  .pi-article-page .article-header {
    max-width: 780px;
  }

  .pi-article-page .article-prose--pi {
    max-width: none;
  }

  .pi-article-page .article-prose--pi > p {
    max-width: 62ch;
  }

  .pi-field {
    margin: 0 0 2.4rem;
    color: #f7eee0;
  }

  .pi-field__intro {
    display: grid;
    gap: 0.55rem;
    max-width: 44rem;
    margin: 0 0 1rem;
  }

  .pi-field__kicker {
    margin: 0;
    color: #a4cfc8;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .pi-field h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 2.15rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .pi-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 560px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid rgba(22, 32, 43, 0.36);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse at 50% 48%, rgba(30, 67, 76, 0.68), transparent 42%),
      linear-gradient(135deg, #071116 0%, #0d1820 48%, #10130f 100%);
    box-shadow: 0 22px 58px rgba(8, 17, 22, 0.24);
  }

  .pi-stage__canvas,
  .pi-stage__mesh,
  .pi-rings,
  .pi-particles,
  .pi-core,
  .pi-wave,
  .pi-digit-stream {
    position: absolute;
  }

  .pi-stage__canvas {
    inset: 0;
    z-index: 3;
  }

  .pi-stage__mesh {
    inset: 0;
    z-index: 1;
    opacity: 0.48;
    background-image:
      linear-gradient(rgba(247, 238, 224, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 238, 224, 0.05) 1px, transparent 1px),
      repeating-linear-gradient(115deg, transparent 0 20px, rgba(43, 199, 189, 0.07) 21px 22px);
    background-size: 34px 34px, 34px 34px, 92px 92px;
  }

  .pi-rings {
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .pi-ring {
    position: absolute;
    left: 50%;
    top: 48%;
    width: var(--size);
    aspect-ratio: 1;
    opacity: var(--alpha);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(var(--turn));
    background: conic-gradient(from var(--turn), transparent 0deg 22deg, var(--tone) 23deg 35deg, transparent 36deg 82deg, rgba(247, 238, 224, 0.26) 83deg 86deg, transparent 87deg 360deg);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
    animation: pi-spin var(--speed) linear infinite;
  }

  .pi-ring span {
    position: absolute;
    top: 1.1rem;
    left: 50%;
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    transform: translateX(-50%);
  }

  .pi-particles {
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  .pi-particle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    line-height: 1;
    opacity: 0.62;
    transform: translate(-50%, -50%) rotate(45deg) scale(0.82);
    text-shadow: 0 0 14px color-mix(in srgb, var(--tone) 82%, transparent);
    animation: pi-particle var(--dur) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .pi-particle::before {
    content: "";
    position: absolute;
    inset: -1px;
    border: 1px solid currentColor;
  }

  .pi-particle {
    color: var(--tone);
  }

  .pi-particle > * {
    transform: rotate(-45deg);
  }

  .pi-core {
    left: 50%;
    top: 48%;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 8.4rem;
    aspect-ratio: 1;
    color: #f7eee0;
    transform: translate(-50%, -50%);
    clip-path: polygon(50% 0, 88% 12%, 100% 50%, 88% 88%, 50% 100%, 12% 88%, 0 50%, 12% 12%);
    background: linear-gradient(135deg, rgba(242, 179, 95, 0.96), rgba(43, 199, 189, 0.74) 52%, rgba(255, 107, 74, 0.84));
    box-shadow: 0 0 44px rgba(43, 199, 189, 0.22);
  }

  .pi-core::before {
    content: "";
    position: absolute;
    inset: 2px;
    clip-path: inherit;
    background: rgba(7, 17, 22, 0.86);
  }

  .pi-core span,
  .pi-core small {
    position: relative;
    z-index: 1;
  }

  .pi-core span {
    font-family: var(--font-display);
    font-size: 4.2rem;
    line-height: 0.9;
  }

  .pi-core small {
    align-self: start;
    margin-top: -0.7rem;
    color: #a4cfc8;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .pi-wave {
    top: 1.1rem;
    right: 1.1rem;
    bottom: 5.7rem;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(26, minmax(2px, 1fr));
    align-items: end;
    gap: 0.2rem;
    width: min(14rem, 25%);
    opacity: 0.88;
  }

  .pi-wave span {
    display: block;
    height: var(--h);
    min-height: 12%;
    background: var(--tone);
    transform-origin: bottom;
    animation: pi-wave var(--dur) ease-in-out infinite;
    animation-delay: var(--delay);
    box-shadow: 0 0 16px color-mix(in srgb, var(--tone) 42%, transparent);
  }

  .pi-digit-stream {
    inset: auto 0 0;
    z-index: 6;
    display: grid;
    grid-template-columns: repeat(52, minmax(0, 1fr));
    align-items: center;
    height: 4.7rem;
    overflow: hidden;
    padding: 0 1rem;
    border-top: 1px solid rgba(247, 238, 224, 0.16);
    background: rgba(7, 17, 22, 0.72);
  }

  .pi-digit-stream span {
    min-width: 0;
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    text-align: center;
    opacity: 0.66;
    animation: pi-digit 2.8s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .pi-ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(22, 32, 43, 0.2);
    border-top: 0;
    background: #0d1820;
    color: #dbe9df;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pi-ledger span {
    min-width: 0;
    padding: 0.78rem 1rem;
    border-right: 1px solid rgba(247, 238, 224, 0.13);
  }

  .pi-ledger span:last-child {
    border-right: 0;
  }

  .pi-ledger strong {
    color: #f2b35f;
    font-weight: 500;
  }

  @keyframes pi-spin {
    to {
      transform: translate(-50%, -50%) rotate(calc(var(--turn) + 1turn));
    }
  }

  @keyframes pi-particle {
    0%,
    100% {
      opacity: 0.28;
      transform: translate(-50%, -50%) rotate(45deg) scale(0.62);
    }
    46% {
      opacity: 0.92;
      transform: translate(-50%, -50%) rotate(45deg) scale(1.18);
    }
  }

  @keyframes pi-wave {
    0%,
    100% {
      opacity: 0.34;
      transform: scaleY(0.38);
    }
    50% {
      opacity: 0.95;
      transform: scaleY(1);
    }
  }

  @keyframes pi-digit {
    0%,
    100% {
      opacity: 0.42;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-0.45rem);
    }
  }

  @media (max-width: 760px) {
    .pi-article-page .article-layout__inner--pi {
      width: min(calc(100% - 1rem), 1120px);
      padding-inline: 1rem;
    }

    .pi-field h2 {
      font-size: 1.72rem;
    }

    .pi-stage {
      min-height: 540px;
      aspect-ratio: 4 / 5;
    }

    .pi-wave {
      display: none;
    }

    .pi-core {
      width: 6.9rem;
    }

    .pi-core span {
      font-size: 3.3rem;
    }

    .pi-digit-stream {
      grid-template-columns: repeat(26, minmax(0, 1fr));
      height: 4.2rem;
      padding-inline: 0.55rem;
    }

    .pi-digit-stream span {
      font-size: 0.66rem;
    }

    .pi-ledger {
      grid-template-columns: 1fr;
    }

    .pi-ledger span {
      border-right: 0;
      border-bottom: 1px solid rgba(247, 238, 224, 0.13);
    }

    .pi-ledger span:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-ring,
    .pi-particle,
    .pi-wave span,
    .pi-digit-stream span {
      animation: none;
    }
  }
</style>
