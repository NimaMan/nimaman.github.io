---
const piDigits =
  "314159265358979323846264338327950288419716939937510582097494459230781640628620899862803482534211706798214808651328230664709384460955058223172535940812848111745028410270193852110555964462294895493038196";

const tones = ["#f2b35f", "#2bc7bd", "#ff6b4a", "#b7df62", "#f38ab0"];

const beatBars = Array.from({ length: 72 }, (_, index) => {
  const digit = Number(piDigits[index % piDigits.length]);
  const next = Number(piDigits[(index + 5) % piDigits.length]);
  const height = 18 + ((digit * 9 + next * 7 + index) % 78);
  const delay = -((index % 24) * 0.09 + digit * 0.035);
  const duration = 1.8 + ((digit + next) % 7) * 0.18;
  const tone = tones[(digit + index) % tones.length];

  return {
    style: `--h:${height}%; --delay:${delay.toFixed(2)}s; --dur:${duration.toFixed(2)}s; --tone:${tone};`,
  };
});

const digitTape = Array.from({ length: 180 }, (_, index) => {
  const digit = piDigits[index % piDigits.length];
  const delay = -((index % 45) * 0.06 + Number(digit) * 0.025);
  const tone = tones[(Number(digit) + index) % tones.length];

  return {
    digit,
    style: `--delay:${delay.toFixed(2)}s; --tone:${tone};`,
  };
});

const orbitMarks = Array.from({ length: 36 }, (_, index) => {
  const digit = piDigits[index % piDigits.length];
  const tone = tones[(Number(digit) + index) % tones.length];
  const turn = (index / 36) * 360 + Number(digit) * 1.7;

  return {
    digit,
    style: `--turn:${turn.toFixed(2)}deg; --tone:${tone};`,
  };
});

const figurePaths = Array.from({ length: 5 }, (_, pass) => {
  const points = Array.from({ length: 260 }, (_, index) => {
    const digit = Number(piDigits[(index + pass * 19) % piDigits.length]);
    const next = Number(piDigits[(index + pass * 19 + 1) % piDigits.length]);
    const theta = (index / 259) * Math.PI * 2 * (1.45 + pass * 0.34);
    const petal = Math.sin(theta * (2 + (next % 5)) + pass * 0.8) * (34 + digit * 4);
    const radius = 130 + pass * 34 + digit * 11 + petal;
    const x = 500 + Math.cos(theta + digit * 0.025) * radius;
    const y = 310 + Math.sin(theta * (0.98 + (next % 3) * 0.018) + pass * 0.28) * radius * 0.68;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const tone = tones[(pass * 2 + 1) % tones.length];

  return {
    points: points.join(" "),
    style: `--figure-tone:${tone}; --figure-delay:${(-pass * 0.72).toFixed(2)}s; --figure-speed:${(9.4 + pass * 1.5).toFixed(2)}s;`,
  };
});

const resonanceCells = Array.from({ length: 96 }, (_, index) => {
  const digit = Number(piDigits[index % piDigits.length]);
  const next = Number(piDigits[(index + 8) % piDigits.length]);
  const x = 50 + Math.cos(index * 2.399963 + digit * 0.16) * (18 + ((digit * 3 + next + index) % 34));
  const y = 48 + Math.sin(index * 2.399963 + next * 0.11) * (14 + ((next * 4 + index) % 30));
  const tone = tones[(digit + next + index) % tones.length];
  const delay = -((index % 32) * 0.08 + digit * 0.025);

  return {
    style: `--x:${x.toFixed(2)}%; --y:${y.toFixed(2)}%; --delay:${delay.toFixed(2)}s; --tone:${tone};`,
  };
});
---

<section class="pi-rhythm" data-pi-rhythm data-pi-digits={piDigits} aria-label="Pi rhythm visualization">
  <div class="pi-rhythm__stage">
    <canvas class="pi-rhythm__canvas" data-pi-webgl aria-label="Three dimensional rhythm generated from the digits of pi"></canvas>

    <div class="pi-rhythm__signal" aria-hidden="true">
      <span>3.14159265358979323846</span>
      <strong><em>π</em></strong>
    </div>

    <button class="pi-rhythm__sound" type="button" data-pi-sound aria-pressed="false">
      <span class="pi-rhythm__sound-icon" data-pi-sound-icon aria-hidden="true">▶</span>
      <span data-pi-sound-label>Play pi beat</span>
    </button>

    <svg class="pi-rhythm__figures" viewBox="0 0 1000 620" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {
        figurePaths.map((figure) => (
          <polyline points={figure.points} style={figure.style}></polyline>
        ))
      }
    </svg>

    <div class="pi-rhythm__resonance" aria-hidden="true">
      {resonanceCells.map((cell) => <span style={cell.style}></span>)}
    </div>

    <div class="pi-rhythm__orbit" aria-hidden="true">
      {orbitMarks.map((mark) => <span style={mark.style}>{mark.digit}</span>)}
    </div>

    <div class="pi-rhythm__meter" aria-hidden="true">
      {beatBars.map((bar) => <span style={bar.style}></span>)}
    </div>

    <div class="pi-rhythm__tape" aria-hidden="true">
      {digitTape.map((item) => <span style={item.style}>{item.digit}</span>)}
    </div>
  </div>

  <div class="pi-rhythm__caption">
    <span>Orbit</span>
    <span>Pulse</span>
    <span>Drift</span>
  </div>
</section>

<script>
  import * as THREE from "three";

  const roots = document.querySelectorAll("[data-pi-rhythm]");
  const reduceQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  roots.forEach((root) => {
    const canvas = root.querySelector("[data-pi-webgl]");
    const stage = root.querySelector(".pi-rhythm__stage");
    const soundButton = root.querySelector("[data-pi-sound]");
    const soundLabel = root.querySelector("[data-pi-sound-label]");
    const soundIcon = root.querySelector("[data-pi-sound-icon]");
    const meterNodes = Array.from(root.querySelectorAll(".pi-rhythm__meter span"));
    const tapeNodes = Array.from(root.querySelectorAll(".pi-rhythm__tape span"));
    const orbitNodes = Array.from(root.querySelectorAll(".pi-rhythm__orbit span"));
    const resonanceNodes = Array.from(root.querySelectorAll(".pi-rhythm__resonance span"));

    if (!(canvas instanceof HTMLCanvasElement) || !(stage instanceof HTMLElement)) return;

    const digits = (root.getAttribute("data-pi-digits") || "")
      .split("")
      .map((digit) => Number(digit))
      .filter((digit) => Number.isFinite(digit));

    const digitAt = (index) => digits[((index % digits.length) + digits.length) % digits.length] || 0;
    const colors = [0xf2b35f, 0x2bc7bd, 0xff6b4a, 0xb7df62, 0xf38ab0].map((color) => new THREE.Color(color));

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      preserveDrawingBuffer: true,
      powerPreference: "high-performance",
    });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 80);
    camera.position.set(0, 0, 8.4);

    const rootGroup = new THREE.Group();
    rootGroup.rotation.x = -0.18;
    scene.add(rootGroup);

    scene.add(new THREE.AmbientLight(0xd7fff3, 1.2));

    const keyLight = new THREE.PointLight(0xf2b35f, 36, 18);
    keyLight.position.set(3.5, -2.2, 6);
    scene.add(keyLight);

    const coolLight = new THREE.PointLight(0x2bc7bd, 22, 18);
    coolLight.position.set(-4, 2.5, 5);
    scene.add(coolLight);

    const coreMaterial = new THREE.MeshStandardMaterial({
      color: 0x0b1518,
      emissive: 0x2bc7bd,
      emissiveIntensity: 0.8,
      metalness: 0.26,
      roughness: 0.34,
      transparent: true,
      opacity: 0.96,
    });
    const core = new THREE.Mesh(new THREE.IcosahedronGeometry(1.05, 3), coreMaterial);
    rootGroup.add(core);

    const rings = Array.from({ length: 5 }, (_, index) => {
      const digit = digitAt(index);
      const radius = 1.42 + index * 0.58 + digit * 0.018;
      const tube = 0.022 + index * 0.005;
      const material = new THREE.MeshStandardMaterial({
        color: colors[index % colors.length],
        emissive: colors[index % colors.length],
        emissiveIntensity: 1.2 - index * 0.12,
        metalness: 0.08,
        roughness: 0.42,
        transparent: true,
        opacity: 0.62 - index * 0.045,
      });
      const mesh = new THREE.Mesh(new THREE.TorusGeometry(radius, tube, 10, 180), material);
      mesh.rotation.x = Math.PI / 2 + index * 0.22;
      mesh.rotation.y = index * 0.36;
      mesh.userData = {
        speed: 0.16 + digit * 0.018 + index * 0.025,
        pulse: 0.022 + digit * 0.004,
      };
      rootGroup.add(mesh);
      return mesh;
    });

    const rodGroup = new THREE.Group();
    rootGroup.add(rodGroup);
    const rods = Array.from({ length: 72 }, (_, index) => {
      const digit = digitAt(index);
      const next = digitAt(index + 1);
      const material = new THREE.MeshStandardMaterial({
        color: colors[(digit + index) % colors.length],
        emissive: colors[(next + index) % colors.length],
        emissiveIntensity: 0.9,
        transparent: true,
        opacity: 0.76,
        roughness: 0.38,
      });
      const mesh = new THREE.Mesh(new THREE.BoxGeometry(0.026, 0.34 + digit * 0.035, 0.026), material);
      const angle = (index / 72) * Math.PI * 2;
      const radius = 3.15 + ((digit + next) % 5) * 0.035;
      mesh.position.set(Math.cos(angle) * radius, Math.sin(angle) * radius, -0.1);
      mesh.rotation.z = angle;
      mesh.userData = {
        phase: index * 0.19 + digit,
      };
      rodGroup.add(mesh);
      return mesh;
    });

    const chordGeometry = new THREE.BufferGeometry();
    const chordPositions = new Float32Array(96 * 2 * 3);
    const chordColors = new Float32Array(96 * 2 * 3);
    for (let i = 0; i < 96; i += 1) {
      const digit = digitAt(i);
      const next = digitAt(i + 1);
      const a = (i / 96) * Math.PI * 2 + digit * 0.05;
      const b = (((i + 11 + next * 3) % 96) / 96) * Math.PI * 2 + next * 0.05;
      const ra = 3.2 + digit * 0.03;
      const rb = 3.2 + next * 0.03;
      const color = colors[(digit + next + i) % colors.length];
      chordPositions[i * 6] = Math.cos(a) * ra;
      chordPositions[i * 6 + 1] = Math.sin(a) * ra * 0.72;
      chordPositions[i * 6 + 2] = -0.55 + (digit - 4.5) * 0.025;
      chordPositions[i * 6 + 3] = Math.cos(b) * rb;
      chordPositions[i * 6 + 4] = Math.sin(b) * rb * 0.72;
      chordPositions[i * 6 + 5] = -0.55 + (next - 4.5) * 0.025;
      chordColors[i * 6] = color.r;
      chordColors[i * 6 + 1] = color.g;
      chordColors[i * 6 + 2] = color.b;
      chordColors[i * 6 + 3] = color.r;
      chordColors[i * 6 + 4] = color.g;
      chordColors[i * 6 + 5] = color.b;
    }
    chordGeometry.setAttribute("position", new THREE.BufferAttribute(chordPositions, 3));
    chordGeometry.setAttribute("color", new THREE.BufferAttribute(chordColors, 3));
    const chords = new THREE.LineSegments(
      chordGeometry,
      new THREE.LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: 0.38,
        blending: THREE.AdditiveBlending,
      }),
    );
    rootGroup.add(chords);

    const pointCount = 620;
    const positions = new Float32Array(pointCount * 3);
    const pointColors = new Float32Array(pointCount * 3);
    const baseAngles = new Float32Array(pointCount);
    const baseRadii = new Float32Array(pointCount);
    const baseDepths = new Float32Array(pointCount);

    for (let i = 0; i < pointCount; i += 1) {
      const digit = digitAt(i);
      const next = digitAt(i + 1);
      const color = colors[(digit + i) % colors.length];
      baseAngles[i] = i * 2.399963 + digit * 0.087 + next * 0.021;
      baseRadii[i] = 0.65 + (((digit * 13 + next * 7 + i) % 100) / 100) * 3.65;
      baseDepths[i] = ((next - 4.5) / 4.5) * 1.08;
      pointColors[i * 3] = color.r;
      pointColors[i * 3 + 1] = color.g;
      pointColors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    particleGeometry.setAttribute("color", new THREE.BufferAttribute(pointColors, 3));

    const particleMaterial = new THREE.PointsMaterial({
      size: 0.082,
      sizeAttenuation: true,
      vertexColors: true,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const particles = new THREE.Points(particleGeometry, particleMaterial);
    rootGroup.add(particles);

    let frame = 0;
    let soundPulse = 0;
    let audioContext;
    let masterGain;
    let beatTimer = 0;
    let soundIndex = 0;
    let activeNodeSets = [];
    const scale = [146.83, 164.81, 196, 220, 246.94, 293.66, 329.63, 392, 440, 493.88];

    const clearActiveNodes = () => {
      activeNodeSets.forEach((node) => node.classList.remove("is-active"));
      activeNodeSets = [];
    };

    const markActiveNodes = (index) => {
      clearActiveNodes();
      const nodes = [
        meterNodes[index % meterNodes.length],
        tapeNodes[index % tapeNodes.length],
        orbitNodes[index % orbitNodes.length],
        resonanceNodes[index % resonanceNodes.length],
      ].filter(Boolean);
      nodes.forEach((node) => node.classList.add("is-active"));
      activeNodeSets = nodes;
    };

    const ensureAudio = async () => {
      const AudioCtor = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtor) return false;
      if (!audioContext) {
        audioContext = new AudioCtor();
        masterGain = audioContext.createGain();
        masterGain.gain.value = 0.18;
        masterGain.connect(audioContext.destination);
      }
      if (audioContext.state === "suspended") {
        await audioContext.resume();
      }
      return true;
    };

    const playTone = (time, digit, duration = 0.12) => {
      if (!audioContext || !masterGain) return;
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = digit % 2 === 0 ? "triangle" : "sine";
      oscillator.frequency.setValueAtTime(scale[digit] * (digit > 6 ? 1.5 : 1), time);
      oscillator.frequency.exponentialRampToValueAtTime(scale[(digit + 3) % scale.length] * 1.25, time + duration);
      gain.gain.setValueAtTime(0.0001, time);
      gain.gain.exponentialRampToValueAtTime(0.12 + digit * 0.008, time + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, time + duration);
      oscillator.connect(gain).connect(masterGain);
      oscillator.start(time);
      oscillator.stop(time + duration + 0.02);
    };

    const playKick = (time, digit) => {
      if (!audioContext || !masterGain) return;
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = "sine";
      oscillator.frequency.setValueAtTime(120 + digit * 8, time);
      oscillator.frequency.exponentialRampToValueAtTime(42, time + 0.16);
      gain.gain.setValueAtTime(0.0001, time);
      gain.gain.exponentialRampToValueAtTime(0.22, time + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.18);
      oscillator.connect(gain).connect(masterGain);
      oscillator.start(time);
      oscillator.stop(time + 0.2);
    };

    const playTick = (time, digit) => {
      if (!audioContext || !masterGain) return;
      const length = Math.floor(audioContext.sampleRate * 0.035);
      const buffer = audioContext.createBuffer(1, length, audioContext.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < length; i += 1) {
        data[i] = (Math.random() * 2 - 1) * (1 - i / length);
      }
      const source = audioContext.createBufferSource();
      const filter = audioContext.createBiquadFilter();
      const gain = audioContext.createGain();
      filter.type = "highpass";
      filter.frequency.value = 2600 + digit * 260;
      gain.gain.setValueAtTime(0.0001, time);
      gain.gain.exponentialRampToValueAtTime(0.06 + digit * 0.004, time + 0.006);
      gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.04);
      source.buffer = buffer;
      source.connect(filter).connect(gain).connect(masterGain);
      source.start(time);
      source.stop(time + 0.05);
    };

    const playBeatStep = () => {
      if (!audioContext) return;
      const digit = digitAt(soundIndex);
      const next = digitAt(soundIndex + 1);
      const now = audioContext.currentTime;
      const swing = (next % 3) * 0.012;
      playTone(now, digit, 0.1 + next * 0.008);
      playTick(now + 0.018 + swing, next);
      if ([0, 3, 6, 9].includes(digit)) {
        playKick(now, digit);
      }
      if ([2, 3, 5, 7].includes(next)) {
        playTone(now + 0.085, next, 0.08);
      }
      soundPulse = 1.35;
      markActiveNodes(soundIndex);
      soundIndex = (soundIndex + 1) % digits.length;
    };

    const setSoundState = (isPlaying) => {
      root.classList.toggle("is-sounding", isPlaying);
      soundButton?.setAttribute("aria-pressed", String(isPlaying));
      if (soundLabel) soundLabel.textContent = isPlaying ? "Stop pi beat" : "Play pi beat";
      if (soundIcon) soundIcon.textContent = isPlaying ? "■" : "▶";
    };

    const stopSound = () => {
      window.clearInterval(beatTimer);
      beatTimer = 0;
      setSoundState(false);
      clearActiveNodes();
    };

    const startSound = async () => {
      if (beatTimer) {
        stopSound();
        return;
      }
      const ready = await ensureAudio();
      if (!ready) return;
      setSoundState(true);
      playBeatStep();
      beatTimer = window.setInterval(playBeatStep, 150);
    };

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      const width = Math.max(1, rect.width);
      const height = Math.max(1, rect.height);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };

    const render = (timestamp, continueAnimation) => {
      const t = timestamp * 0.001;
      const beatIndex = Math.floor(t * 10) % digits.length;
      const beat = digitAt(beatIndex) / 9;
      const slowBeat = digitAt(beatIndex + 13) / 9;
      soundPulse *= 0.9;
      const audiblePulse = Math.max(0, soundPulse);

      rootGroup.rotation.z = Math.sin(t * 0.19) * 0.08 + audiblePulse * 0.025;
      rootGroup.rotation.y = Math.sin(t * 0.27) * 0.16;

      core.rotation.x = t * 0.31;
      core.rotation.y = t * 0.47;
      core.scale.setScalar(1.12 + beat * 0.24 + audiblePulse * 0.24 + Math.sin(t * 2.4) * 0.045);
      coreMaterial.emissiveIntensity = 1.15 + beat * 0.9 + audiblePulse * 1.2;
      chords.material.opacity = 0.3 + beat * 0.22 + audiblePulse * 0.24;

      rings.forEach((ring, index) => {
        const ringBeat = digitAt(beatIndex + index * 7) / 9;
        const direction = index % 2 === 0 ? 1 : -1;
        ring.rotation.z += direction * ring.userData.speed * 0.012;
        ring.rotation.x += direction * 0.0025;
        ring.scale.setScalar(1 + Math.sin(t * (1.2 + index * 0.18) + ringBeat * Math.PI) * ring.userData.pulse + ringBeat * 0.035);
        ring.material.opacity = 0.44 + ringBeat * 0.42 + audiblePulse * 0.1;
      });

      rods.forEach((rod, index) => {
        const digit = digitAt(beatIndex + index);
        const lift = 0.75 + (digit / 9) * 2.05 + Math.max(0, Math.sin(t * 3.2 + rod.userData.phase)) * 0.7 + audiblePulse * 0.34;
        rod.scale.y = lift;
        rod.position.z = -0.45 + lift * 0.08 + slowBeat * 0.15;
        rod.material.opacity = 0.48 + (digit / 9) * 0.46 + audiblePulse * 0.08;
      });

      for (let i = 0; i < pointCount; i += 1) {
        const digit = digitAt(i + beatIndex);
        const next = digitAt(i + beatIndex + 1);
        const angle = baseAngles[i] + t * (0.06 + digit * 0.004) + Math.sin(t * 0.34 + i * 0.011) * 0.18;
        const radius = baseRadii[i] * (0.88 + beat * 0.08) + Math.sin(t * 1.7 + next) * 0.08;
        positions[i * 3] = Math.cos(angle) * radius;
        positions[i * 3 + 1] = Math.sin(angle * (1.02 + next * 0.002)) * radius * 0.72;
        positions[i * 3 + 2] = baseDepths[i] + Math.sin(t * 0.9 + digit + i * 0.03) * 0.42;
      }
      particleGeometry.attributes.position.needsUpdate = true;

      renderer.render(scene, camera);

      if (continueAnimation && !reduceQuery.matches) {
        frame = window.requestAnimationFrame((time) => render(time, true));
      }
    };

    const start = () => {
      window.cancelAnimationFrame(frame);
      resize();
      render(window.performance.now(), false);
      if (!reduceQuery.matches) {
        frame = window.requestAnimationFrame((time) => render(time, true));
      }
    };

    const stop = () => {
      window.cancelAnimationFrame(frame);
      frame = 0;
      render(3141.59, false);
    };

    const observer = new ResizeObserver(start);
    observer.observe(stage);
    soundButton?.addEventListener("click", startSound);

    reduceQuery.addEventListener("change", () => {
      if (reduceQuery.matches) {
        stop();
      } else {
        start();
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        window.cancelAnimationFrame(frame);
        stopSound();
      } else {
        start();
      }
    });

    start();
  });
</script>

<style is:inline>
  .pi-article-page .article-layout__inner--pi {
    width: min(1180px, calc(100% - 2.5rem));
  }

  .pi-article-page .article-header {
    max-width: 760px;
    padding-bottom: 1.35rem;
    margin-bottom: 1.35rem;
  }

  .pi-article-page .article-prose--pi {
    max-width: none;
  }

  .pi-article-page .article-prose--pi > p {
    max-width: 58ch;
  }

  .pi-rhythm {
    margin: 0 0 2.4rem;
  }

  .pi-rhythm__stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 650px;
    aspect-ratio: 16 / 9.7;
    overflow: hidden;
    border: 1px solid rgba(12, 22, 26, 0.64);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 50% 46%, rgba(43, 199, 189, 0.2), transparent 24%),
      radial-gradient(circle at 35% 68%, rgba(242, 179, 95, 0.18), transparent 29%),
      radial-gradient(circle at 70% 32%, rgba(255, 107, 74, 0.16), transparent 26%),
      linear-gradient(135deg, #061014 0%, #0d1717 48%, #15170d 100%);
    box-shadow: 0 28px 70px rgba(8, 16, 18, 0.28);
  }

  .pi-rhythm__stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.5;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(247, 238, 224, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 238, 224, 0.045) 1px, transparent 1px),
      repeating-radial-gradient(circle at center, transparent 0 72px, rgba(247, 238, 224, 0.055) 73px 74px);
    background-size: 32px 32px, 32px 32px, 100% 100%;
  }

  .pi-rhythm__stage::after {
    content: "";
    position: absolute;
    inset: -18%;
    z-index: 1;
    opacity: 0;
